# ── GitHub Token (used for GitHub Models API — free GPT-4o) ──────────────────
# Get it free: GitHub -> Settings -> Developer Settings -> Personal Access Tokens -> Fine-grained
GITHUB_TOKEN=your_github_personal_access_token_here

# ── GitHub Webhook (Optional) ────────────────────────────────────────────────
GITHUB_WEBHOOK_SECRET=BuildAI

# ── Microsoft Teams Notifications (Optional Webhook) ────────────────────────
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/abc...

# ── Azure Key Vault (Optional - loads secrets securely from Vault) ───────────
# AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/

# ── Azure AI Search (Optional - production RAG vector database) ─────────────
# AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
# AZURE_SEARCH_KEY=your-search-api-key
# AZURE_SEARCH_INDEX=sentinelforge-kb

# ── Azure OpenAI (Optional - if using direct Azure OpenAI deployments) ──────
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-05-01-preview
# AZURE_OPTIMIZER_DEPLOYMENT=gpt-4o
# AZURE_AUDITOR_DEPLOYMENT=gpt-4o-mini
